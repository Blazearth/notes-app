# Weavr — local environment template.
#
# Copy to .env and fill in the secrets. .env is gitignored; never commit it.
#   cp .env.example .env
#
# Load before running the API. From Git Bash:
#   set -a && source .env && set +a && (cd api && ./mvnw spring-boot:run)


# =============================================================================
# Supabase — project sgjpiordywdklzhlhmwq (aws-0-ap-northeast-1 / Tokyo)
# =============================================================================
WEAVR_SUPABASE_URL=https://sgjpiordywdklzhlhmwq.supabase.co

# Public anon key — safe to ship inside client binaries; used only for server-
# side test/verify flows (sign-up a throwaway user, mint a JWT, exercise the
# real create path). Find it in Supabase Dashboard → Settings → API → anon/public.
SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# RUNTIME connection -> TRANSACTION pooler, port 6543
# -----------------------------------------------------------------------------
# prepareThreshold=0 is REQUIRED. The transaction pooler hands out a different
# backend per transaction, so server-side prepared statements produce
# intermittent "prepared statement S_1 already exists" errors under load.
# Keep the pool small — free-tier connections are scarce.
WEAVR_DB_URL='jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require'
WEAVR_DB_USER=postgres.sgjpiordywdklzhlhmwq
WEAVR_DB_PASSWORD=
WEAVR_DB_POOL_MAX=8


# -----------------------------------------------------------------------------
# MIGRATIONS -> SESSION pooler, port 5432   (deliberately a different URL)
# -----------------------------------------------------------------------------
# Flyway takes a session-level advisory lock and runs DDL in transactions.
# Both break under the transaction pooler — and they break LATER, under
# concurrency, not on the first migration. Do not point this at 6543.
WEAVR_FLYWAY_URL='jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require'
WEAVR_FLYWAY_USER=postgres.sgjpiordywdklzhlhmwq
WEAVR_FLYWAY_PASSWORD=


# =============================================================================
# App
# =============================================================================
PORT=8080
WEAVR_LOG_LEVEL=INFO


# =============================================================================
# External binaries — yt-dlp and ffmpeg
# =============================================================================
# Both are invoked via ProcessBuilder, so they must be on PATH (or named
# absolutely below). They are NOT Maven dependencies: nothing at build time will
# tell you they are missing, and the runtime symptom is every save retrying
# until it exhausts max_attempts. Check with:
#   yt-dlp --version && ffmpeg -version | head -1
#
# The Docker image must install both — a plain JRE base image has neither.
# WEAVR_YTDLP_BINARY=yt-dlp

# --sub-langs value. EXACT CODES, never a regex: each entry is matched as a
# pattern, and yt-dlp synthesises translated tracks named <source>-<target>, so
# "en.*" expands to en-ar, en-ja, en-ru and ~26 more — one fetch became 29
# downloads and an HTTP 429. Default is "en,en-orig".
# WEAVR_YTDLP_SUB_LANGS=en,en-orig

# Opt-in live test against a real yt-dlp and a real video (skipped by default,
# since a third party rate-limiting us should not turn the build red):
#   WEAVR_LIVE_YTDLP=1 ./mvnw test -Dtest=YtDlpLiveTest

# ffmpeg — same PATH requirement as yt-dlp above (ffmpeg -version to check).
# WEAVR_FFMPEG_BINARY=ffmpeg


# =============================================================================
# RapidAPI YouTube — primary metadata + transcript path for YouTube URLs
# =============================================================================
# Bypasses YouTube's datacenter-IP bot check (Render's own IP fails yt-dlp's
# YouTube probe every time — see CLAUDE.md). Blank disables the client; the
# cascade falls back to yt-dlp directly, which then fails every YouTube URL
# on a datacenter host. "ytstream-download-youtube-videos" on RapidAPI.
WEAVR_RAPID_YT_API_KEY=


# =============================================================================
# OCR — the visual tier, step 5 of the cascade
# =============================================================================
# The overlay-text-only case: a recipe Reel whose ingredients exist purely as
# burned-in pixels defeats captions, metadata and ASR alike.
#
# tesseract is a THIRD external binary the image must install, along with its
# English language data — an install without tessdata reads every frame as
# nothing, silently. Check both:
#   tesseract --version && tesseract --list-langs   # must include eng
#
# On Windows, `winget install tesseract-ocr.tesseract` lands it in
# C:\Program Files\Tesseract-OCR and does NOT add it to PATH, so this needs
# setting. In the image, use the distro's tesseract-ocr + tesseract-ocr-eng.
# WEAVR_TESSERACT_BINARY=tesseract

# Kill switch for the whole tier. With it off, a save with no caption, no
# description and no speech fails honestly instead of half-running a tier
# whose binary is missing.
# WEAVR_OCR_ENABLED=true

# The escalation floor: mean per-word confidence (0-100) below which the text
# is assumed to be under the LLM repair floor and the frames go to Flash vision.
#
# THIS IS STILL A GUESS. It has been sanity-checked against two extremes — a
# clean synthetic card reads at 95, a textless clip well below — and never
# measured. Phase 4's thirty-Reel eval set is what turns it into a number.
# Both failure directions are silent: too strict burns the 20/day Flash pool,
# too loose ships invented ingredients nobody reports.
# WEAVR_OCR_MIN_CONFIDENCE=60

# Each frame is its own tesseract process, so this is the tier's cost knob.
# WEAVR_OCR_MAX_FRAMES=12

# Preprocessing for the OCR branch. Upscale and greyscale ONLY — do not add a
# contrast stage without measuring it. Overlay text is high-contrast and
# bimodal by design, and ffmpeg's histeq (the obvious CLAHE stand-in) hollows
# the glyphs: same frame, real tesseract, 16/16 words at confidence 95 without
# it against 7 garbled tokens at 22 with it.
# WEAVR_OCR_FRAME_FILTERS=scale=iw*2:-2:flags=lanczos,format=gray

# Set to false to never spend a Flash vision request; below-floor OCR text is
# then passed through as-is and the classify call's own "unusable" branch
# catches it.
# WEAVR_OCR_VISION_ESCALATION=true

# Opt-in live test against real ffmpeg and real tesseract. Needs NO network —
# it renders its own fixture videos — so it is the cheapest way to prove the
# toolchain is actually installed:
#   WEAVR_LIVE_OCR=1 ./mvnw test -Dtest=OcrLiveTest


# =============================================================================
# Groq — Whisper ASR, step 3 of the extraction cascade
# =============================================================================
# A different provider from Gemini on purpose: its own key, its own
# rate-limit pool. Get a key at https://console.groq.com/keys. Free tier:
# 2,000 requests/day, 28,800 audio-seconds/day for whisper-large-v3-turbo —
# verify current limits at https://console.groq.com/docs/rate-limits before
# sizing anything against it, the same way the Gemini RPD below has to be.
WEAVR_GROQ_API_KEY=

# Upper bound on audio downloaded per save (yt-dlp --download-sections).
# Long-form video would otherwise cost the same worker-stall risk as a
# 90-second Reel. Default 90.
# WEAVR_GROQ_MAX_AUDIO_SECONDS=90


# =============================================================================
# Enrichment — TMDB, Google Books, and Google Places (Phase 3 step 3)
# =============================================================================
# Fills gaps the content itself never had: a caption rarely names the director
# or carries coordinates. Costs NO Gemini request, which is the whole reason it
# is worth doing on a 500-a-day budget — asking a model to recall a director is
# both a request and a hallucination risk.
#
# Every key is optional. A missing one disables only its own enricher, because
# enrichment happens to a save that is already `ready` and already searchable,
# so it must never be able to fail one.

# The v4 READ ACCESS TOKEN, sent as a bearer — NOT the v3 API key, which goes
# in a query parameter and will 401 against this code.
# https://www.themoviedb.org/settings/api
WEAVR_TMDB_API_KEY=

# Google Books API key. Free tier ~1,000 req/day, no card needed.
# console.cloud.google.com → APIs & Services → Library → "Books API" → Enable
# → Credentials → Create API Key (restrict to Books API only).
WEAVR_GOOGLE_BOOKS_API_KEY=

# Places API (New). The code sends an X-Goog-FieldMask, which is a cost
# decision as much as a payload one — Google bills Places by field-mask tier.
WEAVR_GOOGLE_PLACES_API_KEY=

# WEAVR_ENRICH_ENABLED=true


# =============================================================================
# RevenueCat — entitlements, enforced SERVER-SIDE
# =============================================================================
# The Authorization header value configured on the webhook in the RevenueCat
# dashboard. UNSET DISABLES THE ENDPOINT rather than opening it: the one route
# that decides who has paid must fail closed, and "it worked in dev" is exactly
# how the opposite ships.
WEAVR_REVENUECAT_WEBHOOK_SECRET=

# The entitlement identifier configured in RevenueCat. An event granting some
# other entitlement is recorded but does not make the user Pro.
# WEAVR_ENTITLEMENT_ID=pro

# Free-tier caps. enforce-free-caps is OFF by default and that is a product
# decision, not an unfinished one: a cap only means something once there is a
# paid tier to escape to, and until the store records and RevenueCat products
# exist nobody can subscribe. The counters run either way, so the switch can be
# flipped against real numbers instead of an empty table.
# WEAVR_ENFORCE_FREE_CAPS=false
# WEAVR_FREE_SAVES_PER_MONTH=20
# WEAVR_FREE_ACTS_PER_WEEK=1


# =============================================================================
# Spaces — duplicate detection in a shared Space
# =============================================================================
# 0.15 is a GUESS, argued rather than measured, like the OCR confidence floor.
# The reasoning: real search-query hits measured at 0.27-0.37, and two saves of
# the *same thing* must be far closer than a query that merely describes one.
# A corpus of real duplicate pairs is what turns it into a number.
# WEAVR_DUPLICATE_MAX_DISTANCE=0.15
# WEAVR_DUPLICATE_DETECTION=true


# =============================================================================
# Supabase Storage — screenshot uploads (api/) and extraction artifacts
# (extraction/). Both were in render.yaml but missing from this template —
# the exact F10 drift ("a fresh clone silently runs with the provider
# disabled") applied to storage instead of RapidAPI.
# =============================================================================
# Service-role key: full bucket access, bypasses RLS. Shared by both
# deployables on purpose — one secret value configures both.
WEAVR_SUPABASE_SERVICE_KEY=

# api/'s screenshot-upload bucket. Public — the app displays these images
# directly from the returned URL.
# WEAVR_SUPABASE_STORAGE_BUCKET=screenshots

# extraction/'s artifact bucket (Phase 4 — docs/extraction-architecture.md).
# Must already exist and be PRIVATE, created out-of-band: unlike screenshots
# above, nothing here should ever be reachable except through
# ArtifactStore's own signed ref.
# WEAVR_EXTRACTION_ARTIFACT_BUCKET=extraction-artifacts

# HMAC key ArtifactStore signs artifact refs with. Blank generates an
# ephemeral key at startup — fine for one instance, but the artifact bytes
# now durably survive a restart (Phase 4), so an ephemeral key becomes the
# one thing standing between "restart-safe" and "not." Set explicitly once
# more than one extraction/ instance is deployed.
# WEAVR_EXTRACTION_ARTIFACT_SECRET=

# Shared bearer secret between api/ and extraction/ (Phase 3/5). Blank
# rejects every non-/health request with 401 — "unset disables rather than
# opens," the same rule the RevenueCat webhook secret follows.
# WEAVR_EXTRACTION_SHARED_SECRET=


# =============================================================================
# Not wired up yet — listed so the shape is known. See docs/implementation-plan.md
# =============================================================================
# Phase 3 — Gemini. Verify the REAL requests-per-day at
# https://aistudio.google.com/rate-limit before sizing anything against it;
# it is per-project and no longer published in the docs.
# GEMINI_DAILY_REQUEST_CAP=
