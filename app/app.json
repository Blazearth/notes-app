{
  "expo": {
    "name": "Weavr",
    "slug": "weavr",
    "version": "4.1",
    "orientation": "portrait",
    "scheme": "weavr",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "bundleIdentifier": "com.weavr.app",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.weavr.app"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.weavr.shared"
        ]
      }
    },
    "android": {
      "package": "com.weavr.app",
      "versionCode": 5,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#1C2631"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1C2631",
          "dark": {
            "image": "./assets/images/adaptive-icon-foreground.png",
            "backgroundColor": "#1C2631"
          }
        }
      ],
      "./plugins/withAndroidShareReceiver",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3defb561-b324-4275-b53a-e284d300ab70"
      }
    },
    "owner": "blazearths-team"
  }
}
