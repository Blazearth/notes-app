# Copy to app/.env and fill in. Everything here is inlined into the JS bundle,
# so nothing secret belongs in this file — no service-role key, ever.
#
# EXPO_PUBLIC_* values are read at BUILD time. After changing them, restart the
# bundler (`npx expo start --clear`); a running Metro will not pick them up.

# Same project as the backend's WEAVR_SUPABASE_URL.
EXPO_PUBLIC_SUPABASE_URL=https://sgjpiordywdklzhlhmwq.supabase.co

# Public anon key — Supabase Dashboard -> Settings -> API -> anon/public.
# Designed to ship in client binaries.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Email verification links only redirect into the app (rather than to
# `localhost`) once this project's Redirect URLs allow-list contains
# weavr://auth/callback and the http://localhost:<port>/auth/callback you
# actually dev against. This is a Supabase Dashboard setting, not an env var
# here — see app/README.md's "confirmation-email redirect" section.

# Where Spring Boot is reachable *from the device*, which is not localhost:
#   Android emulator  -> http://10.0.2.2:8080
#   iOS simulator     -> http://localhost:8080
#   physical device   -> http://<your-machine-LAN-IP>:8080
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
